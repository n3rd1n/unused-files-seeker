{
	"name": "@n3rd1n/unused-files-seeker",
	"version": "1.0.0",
	"description": "A tool to find unused files in JavaScript/TypeScript projects",
	"main": "dist/index.js",
	"bin": {
		"unused-files-seeker": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build",
    	"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    	"test": "node dist/cli.js test-project_2/App.tsx --ignore apiAuto"
	},
	"keywords": [
    	"unused",
    	"files",
    	"seeker",
    	"typescript",
    	"javascript",
    	"cleanup"
	],
	"author": "n3rd1n",
	"license": "MIT",
	"files": [
		"dist/**/*",
		"README.md"
	],
	"engines": {
		"node": ">=14.0.0"
	},
  	"dependencies": {
    	"tree-sitter": "^0.21.1",
    	"tree-sitter-typescript": "^0.23.2"
  	},
  	"devDependencies": {
    	"@types/node": "^24.9.1",
    	"typescript": "^5.0.0"
  	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n3rd1n/unused-files-seeker.git"
	},
	"bugs": {
		"url": "https://github.com/n3rd1n/unused-files-seeker/issues"
	},
	"homepage": "https://github.com/n3rd1n/unused-files-seeker#readme"
}
